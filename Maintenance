<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TIVO — Estudio Creativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300;1,9..40,400;1,9..40,500;1,9..40,700&display=swap" rel="stylesheet">
<style>
/* ─── RESET ─── */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;max-width:100%;overflow-x:hidden;}
:root{
  --o:#F04E1A;
  --p:#9B6FD4;
  --b:#EAD9B8;
  --pk:#E8477A;
  --l:#C4D400;
  --g:#4DBD74;
  --bl:#4DB8E8;
  --y:#F9C31F;
  --dark:#0E0804;
  --cream:#F8F4EC;
  /* Tipografía — Syne para titulares (proxy Winking), DM Sans para cuerpo (proxy Articulat CF) */
  --font-head: 'Syne', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  /* Escala fluida */
  --h1: clamp(3rem, 5vw, 5.5rem);
  --h2: clamp(2.2rem, 3.5vw, 3.5rem);
  --h3: clamp(1.3rem, 2vw, 1.8rem);
  /* Layout */
  --max-w: 1280px;
  --px: clamp(20px, 4vw, 64px);
  --sec-py: clamp(60px, 8vw, 100px);
}
html{scroll-behavior:smooth;}
body{background:var(--cream);color:var(--dark);font-family:var(--font-body);cursor:none;font-size:16px;line-height:1.6;}
a{text-decoration:none;color:inherit;}
img,svg{display:block;}

/* ─── CURSOR ─── */
#cursor{position:fixed;z-index:9999;pointer-events:none;width:10px;height:10px;background:var(--o);border-radius:50%;transform:translate(-50%,-50%);transition:width .18s,height .18s,background .18s;mix-blend-mode:multiply;}
#cursor.hover{width:42px;height:42px;background:var(--l);}
#cur-ring{position:fixed;z-index:9998;pointer-events:none;width:30px;height:30px;border:1.5px solid rgba(240,78,26,.25);border-radius:50%;transform:translate(-50%,-50%);}

/* ─── COLOR STRIP ─── */
.cstrip{display:flex;height:4px;width:100%;position:fixed;top:0;left:0;z-index:1000;}
.cs1{background:var(--o);flex:2}.cs2{background:var(--p);flex:2}.cs3{background:var(--b);flex:1.5}.cs4{background:var(--pk);flex:1.5}.cs5{background:var(--l);flex:2}.cs6{background:var(--g);flex:1.5}.cs7{background:var(--bl);flex:1.5}.cs8{background:var(--y);flex:1}

/* ─── NAV ─── */
nav{
  position:fixed;top:4px;left:0;right:0;
  z-index:900;padding:14px var(--px);
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;transition:background .3s;
}
.n-avail{
  display:flex;align-items:center;gap:8px;
  background:#fff;padding:12px 20px;border-radius:100px;
  font-family:var(--font-body);font-size:12px;font-weight:500;color:var(--dark);
  box-shadow:0 6px 24px rgba(14,8,4,.08);flex-shrink:0;white-space:nowrap;
  transition:transform .4s ease,opacity .4s ease;
}
.n-avail-dot{width:8px;height:8px;border-radius:50%;background:var(--g);flex-shrink:0;animation:dotpulse 2s ease-in-out infinite;}
@keyframes dotpulse{0%,100%{transform:scale(1);}50%{transform:scale(1.7);opacity:.5;}}
.n-center{
  display:flex;align-items:center;gap:2px;
  background:#fff;border-radius:100px;padding:7px;
  box-shadow:0 6px 24px rgba(14,8,4,.08);
}
.n-logo{
  width:36px;height:36px;background:var(--dark);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;transition:transform .4s cubic-bezier(.34,1.56,.64,1);
}
.n-logo:hover{transform:rotate(90deg);}
.n-links{display:flex;align-items:center;gap:0;list-style:none;}
.n-links a{
  font-family:var(--font-body);font-size:13px;font-weight:500;color:var(--dark);
  padding:9px 14px;border-radius:100px;transition:all .2s;
}
.n-links a:hover{color:var(--o);background:rgba(14,8,4,.04);}
.n-cta{
  background:var(--o);color:#fff;
  padding:10px 20px;border-radius:100px;
  font-family:var(--font-body);font-size:13px;font-weight:600;
  display:flex;align-items:center;gap:7px;
  transition:all .25s;white-space:nowrap;
  box-shadow:0 4px 18px rgba(240,78,26,.35);
}
.n-cta:hover{background:var(--l);color:var(--dark);transform:scale(1.04);box-shadow:0 8px 24px rgba(196,212,0,.4);}
.n-talk{
  color:var(--dark);font-family:var(--font-body);font-size:13px;font-weight:500;
  padding:12px 22px;border-radius:100px;border:1.5px solid rgba(14,8,4,.1);
  background:#fff;display:inline-flex;align-items:center;gap:7px;
  transition:all .25s;box-shadow:0 6px 24px rgba(14,8,4,.08);white-space:nowrap;
  flex-shrink:0;
  transition:transform .4s ease,opacity .4s ease;
}
.n-talk:hover{border-color:var(--p);color:#fff;background:var(--p);}
.n-ham{display:none;flex-direction:column;gap:5px;cursor:none;border:none;background:none;padding:4px;}
.n-ham span{display:block;width:22px;height:2px;background:var(--dark);border-radius:2px;}

/* ─── HERO ─── */
.hero{
  min-height:100vh;width:100%;
  padding:calc(var(--px) + 80px) var(--px) 72px;
  display:grid;grid-template-columns:1fr 1fr;
  gap:clamp(28px, 4vw, 60px);align-items:center;
  position:relative;overflow:hidden;
}
.hero-bg{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
.hero-bg::before{
  content:'';position:absolute;right:-200px;top:-200px;
  width:700px;height:700px;
  background:radial-gradient(ellipse,rgba(155,111,212,.1) 0%,rgba(240,78,26,.05) 45%,transparent 68%);
  border-radius:50%;animation:blobspin 28s linear infinite;
}
.hero-bg::after{
  content:'';position:absolute;left:-100px;bottom:-100px;
  width:500px;height:500px;
  background:radial-gradient(ellipse,rgba(196,212,0,.08) 0%,transparent 65%);
  border-radius:50%;
}
@keyframes blobspin{to{transform:rotate(360deg);}}

.hero-left{position:relative;z-index:2;}
.h-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--font-body);font-size:10px;font-weight:600;
  letter-spacing:.18em;text-transform:uppercase;color:var(--o);margin-bottom:20px;
}
.h-dot{width:6px;height:6px;border-radius:50%;background:var(--o);animation:dotpulse 2s ease-in-out infinite;}
h1.h1{
  font-family:var(--font-head);
  font-size:var(--h1);font-weight:800;
  line-height:1.0;letter-spacing:-.04em;color:var(--dark);
}
.h1 .sm{
  display:block;font-family:var(--font-body);
  font-size:clamp(.9rem,1.1vw,1rem);font-weight:400;
  color:rgba(14,8,4,.35);margin-top:8px;letter-spacing:0;line-height:1.6;
}
.typing-wrap{
  margin:16px 0 6px;display:inline-flex;align-items:center;
  background:var(--o);padding:8px 22px 10px;border-radius:12px;
  overflow:hidden;position:relative;
}
.typing-wrap::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent);
  animation:shimmer 2.5s ease-in-out infinite;
}
@keyframes shimmer{0%{transform:translateX(-100%);}100%{transform:translateX(100%);}}
#typing{
  font-family:var(--font-head);
  font-size:clamp(1.2rem,2.5vw,2.4rem);font-weight:800;letter-spacing:-.03em;
  color:#fff;white-space:nowrap;position:relative;z-index:1;
}
.blink{display:inline-block;width:2px;height:1em;background:#fff;margin-left:3px;vertical-align:middle;animation:bl .75s step-end infinite;}
@keyframes bl{0%,100%{opacity:1;}50%{opacity:0;}}
.h-tagline{
  font-family:var(--font-body);font-size:clamp(.9rem,1.1vw,1rem);
  font-weight:500;color:var(--dark);margin-top:14px;
}
.h-tagline em{color:var(--p);font-style:italic;}
.h-sub{
  font-family:var(--font-body);font-size:clamp(.85rem,1vw,.95rem);
  line-height:1.85;color:rgba(14,8,4,.42);max-width:460px;margin-top:10px;
}
.h-btns{display:flex;gap:10px;margin-top:28px;flex-wrap:wrap;}
.btn-primary{
  background:var(--o);color:#fff;padding:13px 28px;border-radius:100px;
  font-family:var(--font-body);font-size:13px;font-weight:600;
  display:inline-flex;align-items:center;gap:8px;
  box-shadow:0 6px 22px rgba(240,78,26,.28);
  transition:all .35s cubic-bezier(.34,1.56,.64,1);
}
.btn-primary:hover{transform:scale(1.05) translateY(-2px);box-shadow:0 14px 40px rgba(240,78,26,.4);}
.btn-ghost-sm{
  color:var(--dark);font-family:var(--font-body);font-size:13px;font-weight:500;
  padding:13px 22px;border-radius:100px;border:1.5px solid rgba(14,8,4,.12);
  display:inline-flex;align-items:center;gap:7px;transition:all .25s;
}
.btn-ghost-sm:hover{border-color:var(--p);color:var(--p);}
.h-trust{display:flex;align-items:center;gap:14px;margin-top:32px;}
.trust-avs{display:flex;}
.tav{
  width:32px;height:32px;border-radius:50%;border:2.5px solid var(--cream);
  font-family:var(--font-head);font-size:9px;font-weight:700;color:#fff;
  display:flex;align-items:center;justify-content:center;margin-left:-9px;
}
.tav:first-child{margin-left:0;}
.t1{background:var(--p)}.t2{background:var(--o)}.t3{background:var(--pk)}.t4{background:var(--bl)}
.trust-txt{font-family:var(--font-body);font-size:11px;color:rgba(14,8,4,.38);line-height:1.5;}
.trust-txt b{color:var(--dark);font-weight:600;}
.trust-stars{color:var(--y);font-size:11px;display:block;}

/* ─── LEAD CARD ─── */
.hero-right{position:relative;z-index:2;}
.lcard{
  background:#fff;border-radius:24px;
  box-shadow:0 20px 64px rgba(14,8,4,.1),0 2px 6px rgba(14,8,4,.04);
  overflow:hidden;
}
.lcard-top{background:var(--dark);padding:22px 26px 18px;position:relative;overflow:hidden;}
.lcard-top::before{
  content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(-45deg,transparent,transparent 18px,rgba(255,255,255,.02) 18px,rgba(255,255,255,.02) 36px);
}
.lc-badge{
  display:inline-flex;align-items:center;gap:5px;
  background:var(--l);color:var(--dark);padding:4px 11px;border-radius:100px;
  font-family:var(--font-body);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  margin-bottom:10px;position:relative;
}
.lc-bdot{width:4px;height:4px;border-radius:50%;background:var(--o);animation:dotpulse 1.8s ease-in-out infinite;}
.lc-title{
  font-family:var(--font-head);font-size:15px;font-weight:700;
  color:var(--b);line-height:1.3;letter-spacing:-.02em;position:relative;
}
.lc-title span{color:var(--o);}
.lc-sub{font-family:var(--font-body);font-size:11px;color:rgba(234,217,184,.38);margin-top:6px;line-height:1.55;position:relative;}
.lcard-bens{display:flex;gap:8px;padding:14px 26px 0;}
.lcard-ben{
  flex:1;background:rgba(14,8,4,.03);border:1px solid rgba(14,8,4,.07);
  border-radius:12px;padding:10px 8px;text-align:center;transition:all .2s;
}
.lcard-ben:hover{background:rgba(240,78,26,.05);border-color:rgba(240,78,26,.18);}
.ben-i{font-size:18px;margin-bottom:4px;}
.ben-t{font-family:var(--font-body);font-size:9px;font-weight:600;color:rgba(14,8,4,.38);line-height:1.35;}
.lcard-form{padding:16px 26px 22px;}
.form-div{
  font-family:var(--font-body);font-size:10px;font-weight:600;color:rgba(14,8,4,.28);
  text-align:center;display:flex;align-items:center;gap:8px;margin-bottom:12px;
}
.form-div::before,.form-div::after{content:'';flex:1;height:1px;background:rgba(14,8,4,.07);}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px 11px;margin-bottom:10px;}
.fg label{
  display:block;font-family:var(--font-body);font-size:9px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;color:rgba(14,8,4,.3);margin-bottom:5px;
}
.fg input,.fg select{
  width:100%;height:40px;background:var(--cream);border:1.5px solid rgba(14,8,4,.07);
  border-radius:10px;padding:0 13px;font-family:var(--font-body);font-size:13px;
  font-weight:400;color:var(--dark);outline:none;transition:all .2s;cursor:none;appearance:none;
}
.fg input:focus,.fg select:focus{border-color:var(--o);box-shadow:0 0 0 3px rgba(240,78,26,.09);background:#fff;}
.fg input::placeholder{color:rgba(14,8,4,.2);}
.phone-row{display:flex;gap:7px;}
.pfx{
  width:68px;flex-shrink:0;background:var(--cream);border:1.5px solid rgba(14,8,4,.07);
  border-radius:10px;padding:0 9px;font-family:var(--font-body);font-size:11px;font-weight:600;
  display:flex;align-items:center;gap:4px;height:40px;
}
.sw{position:relative;}
.sw::after{content:'▾';position:absolute;right:11px;top:50%;transform:translateY(-50%);font-size:9px;color:rgba(14,8,4,.28);pointer-events:none;}
.prv{display:flex;align-items:flex-start;gap:7px;margin-top:10px;margin-bottom:12px;}
.prv input{width:14px;height:14px;margin-top:2px;flex-shrink:0;accent-color:var(--o);}
.prv label{font-family:var(--font-body);font-size:10px;color:rgba(14,8,4,.28);line-height:1.55;font-weight:400;}
.prv label a{color:var(--o);}
.btn-dl{
  width:100%;height:48px;background:var(--o);color:#fff;border:none;
  border-radius:11px;font-family:var(--font-head);font-size:11px;font-weight:700;
  letter-spacing:.01em;display:flex;align-items:center;justify-content:center;gap:8px;
  cursor:none;box-shadow:0 6px 20px rgba(240,78,26,.26);
  transition:all .3s cubic-bezier(.34,1.56,.64,1);
}
.btn-dl:hover{transform:scale(1.03) translateY(-2px);box-shadow:0 12px 34px rgba(240,78,26,.38);}
.lcard-proof{
  display:flex;align-items:center;justify-content:center;gap:18px;
  padding:11px 26px 15px;border-top:1px solid rgba(14,8,4,.05);
}
.proof-i{display:flex;align-items:center;gap:5px;font-family:var(--font-body);font-size:10px;font-weight:500;color:rgba(14,8,4,.28);}

/* ─── TICKER ─── */
.ticker{background:var(--dark);padding:12px 0;overflow:hidden;user-select:none;width:100%;}
.ticker-inner{display:flex;width:max-content;animation:tick 30s linear infinite;}
.ticker-inner:hover{animation-play-state:paused;}
@keyframes tick{to{transform:translateX(-50%);}}
.ti{
  display:inline-flex;align-items:center;gap:14px;padding:0 20px;white-space:nowrap;
  font-family:var(--font-body);font-size:10px;font-weight:600;letter-spacing:.16em;
  text-transform:uppercase;color:rgba(234,217,184,.4);
}
.ti-star{font-size:11px;}

/* ─── STATS ─── */
.stats-row{
  display:grid;grid-template-columns:repeat(4,1fr);
  background:#fff;border-top:1px solid rgba(14,8,4,.06);border-bottom:1px solid rgba(14,8,4,.06);
}
.stat{
  padding:36px 40px;border-right:1px solid rgba(14,8,4,.06);
  position:relative;overflow:hidden;transition:background .3s;
}
.stat:last-child{border-right:none;}
.stat:hover{background:var(--cream);}
.stat::before{content:'';position:absolute;top:0;left:0;width:3px;height:0;transition:height .5s;}
.stat:nth-child(1)::before{background:var(--o);}
.stat:nth-child(2)::before{background:var(--p);}
.stat:nth-child(3)::before{background:var(--pk);}
.stat:nth-child(4)::before{background:var(--g);}
.stat:hover::before{height:100%;}
.stat-n{
  font-family:var(--font-head);font-size:clamp(32px,3.5vw,54px);
  font-weight:800;line-height:1;letter-spacing:-.05em;color:var(--dark);
}
.stat-n sup{font-size:.38em;color:var(--o);}
.stat-l{font-family:var(--font-body);font-size:12px;font-weight:400;color:rgba(14,8,4,.34);margin-top:7px;}

/* ─── CLIENTS ─── */
.clients{
  background:#fff;padding:44px var(--px);text-align:center;
  border-bottom:1px solid rgba(14,8,4,.06);
}
.cl-label{
  font-family:var(--font-body);font-size:10px;font-weight:600;
  letter-spacing:.18em;text-transform:uppercase;color:rgba(14,8,4,.2);margin-bottom:28px;
}
.cl-logos{display:flex;align-items:center;justify-content:center;gap:48px;flex-wrap:wrap;}
.cl-name{
  font-family:var(--font-head);font-size:clamp(12px,1.4vw,16px);
  font-weight:700;letter-spacing:-.02em;color:rgba(14,8,4,.1);transition:color .3s;
}
.cl-name:hover{color:var(--o);}

/* ─── BIG MARQUEE ─── */
.bigmq{overflow:hidden;padding:16px 0;background:var(--cream);border-top:1px solid rgba(14,8,4,.06);border-bottom:1px solid rgba(14,8,4,.06);}
.bigmq-inner{display:flex;width:max-content;animation:tick 44s linear infinite;}
.bm-item{
  font-family:var(--font-head);font-size:clamp(40px,6vw,80px);font-weight:800;
  letter-spacing:-.05em;color:transparent;-webkit-text-stroke:1.5px rgba(14,8,4,.08);
  white-space:nowrap;padding:0 28px;transition:all .3s;
}
.bm-item:hover{color:var(--o);-webkit-text-stroke:0;}
.bm-sep{color:var(--o);padding:0 12px;display:flex;align-items:center;font-size:30px;}

/* ─── SECCIÓN ─── */
.sec{padding:var(--sec-py) var(--px);width:100%;}
.sec-eye{
  display:inline-flex;align-items:center;gap:7px;
  font-family:var(--font-body);font-size:9px;font-weight:700;
  letter-spacing:.2em;text-transform:uppercase;color:var(--o);margin-bottom:12px;
}
.sec-h{
  font-family:var(--font-head);font-size:var(--h2);font-weight:800;
  line-height:1.05;letter-spacing:-.04em;color:var(--dark);
}
.sec-h .em{color:var(--o);}
.sec-h .emp{color:var(--p);}
.sec-h .eml{color:var(--l);}

/* ─── CONÓCENOS ─── */
.sec-conocenos{
  display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,5vw,80px);
  align-items:start;background:var(--cream);position:relative;overflow:hidden;
}
.sec-conocenos::after{
  content:'';position:absolute;right:-100px;top:50%;transform:translateY(-50%);
  width:500px;height:500px;
  background:radial-gradient(ellipse,rgba(240,78,26,.05) 0%,transparent 65%);
  border-radius:50%;pointer-events:none;
}
.cn-quote{
  font-family:var(--font-body);font-size:clamp(.95rem,1.2vw,1.1rem);
  font-weight:500;font-style:italic;color:var(--dark);line-height:1.55;
  padding-left:18px;border-left:3px solid var(--o);margin-top:22px;
}
.cn-body{
  font-family:var(--font-body);font-size:14px;line-height:1.85;
  color:rgba(14,8,4,.44);margin-top:18px;
}
.cn-body b{color:var(--dark);font-weight:600;}
.cn-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:22px;}
.cn-tag{
  font-family:var(--font-body);font-size:10px;font-weight:600;
  letter-spacing:.07em;text-transform:uppercase;padding:6px 14px;
  border-radius:100px;border:1.5px solid rgba(14,8,4,.09);
  color:rgba(14,8,4,.35);transition:all .2s;
}
.cn-tag:hover{border-color:var(--o);color:var(--o);}
.cn-cards{display:flex;flex-direction:column;gap:10px;}
.vc{
  background:#fff;border-radius:16px;padding:20px;
  display:flex;gap:15px;align-items:flex-start;
  border:1.5px solid rgba(14,8,4,.06);
  transition:all .35s cubic-bezier(.34,1.56,.64,1);
}
.vc:hover{transform:translateX(9px);box-shadow:0 12px 40px rgba(14,8,4,.08);border-color:transparent;}
.vc.vo{background:var(--o);border-color:transparent;}
.vc.vp{background:var(--p);border-color:transparent;}
.vc.vl{background:var(--l);border-color:transparent;}
.vc-ico{font-size:22px;flex-shrink:0;margin-top:1px;}
.vc-t{font-family:var(--font-head);font-size:13px;font-weight:700;letter-spacing:-.02em;margin-bottom:4px;}
.vo .vc-t,.vp .vc-t{color:#fff;}.vl .vc-t{color:var(--dark);}
.vc:not(.vo):not(.vp):not(.vl) .vc-t{color:var(--dark);}
.vc-d{font-family:var(--font-body);font-size:12px;line-height:1.6;}
.vo .vc-d,.vp .vc-d{color:rgba(255,255,255,.65);}
.vl .vc-d{color:rgba(14,8,4,.5);}
.vc:not(.vo):not(.vp):not(.vl) .vc-d{color:rgba(14,8,4,.38);}

/* ─── TRABAJO / BENTO ─── */
.sec-trabajo{background:var(--dark);}
.tj-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;}
.tj-head .sec-h{color:var(--b);}
.tj-head .sec-eye{color:var(--o);}
.tj-more{
  font-family:var(--font-body);color:rgba(234,217,184,.36);font-size:12px;font-weight:500;
  border:1.5px solid rgba(234,217,184,.09);padding:11px 22px;border-radius:100px;
  display:flex;align-items:center;gap:8px;transition:all .25s;
}
.tj-more:hover{color:var(--b);border-color:rgba(234,217,184,.28);gap:14px;}
.bento{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:44px;gap:10px;}
.bc{border-radius:18px;overflow:hidden;position:relative;cursor:none;}
.bc:hover .bc-fill{transform:scale(1.05);}
.bc:hover .bc-arr{opacity:1;transform:scale(1) rotate(0);}
.bc1{grid-column:1/8;grid-row:1/7;}
.bc2{grid-column:8/13;grid-row:1/5;}
.bc3{grid-column:8/11;grid-row:5/9;}
.bc4{grid-column:11/13;grid-row:5/9;}
.bc5{grid-column:1/5;grid-row:7/11;}
.bc6{grid-column:5/13;grid-row:7/11;}
.bc-fill{position:absolute;inset:0;transition:transform .5s ease;}
.bf1{background:linear-gradient(140deg,var(--o) 0%,#FF7B3C 55%,var(--y) 100%);}
.bf2{background:linear-gradient(135deg,var(--p) 0%,var(--pk) 100%);}
.bf3{background:var(--l);}
.bf4{background:var(--dark);border:1.5px solid rgba(234,217,184,.05);}
.bf5{background:linear-gradient(135deg,var(--pk) 0%,var(--o) 100%);}
.bf6{background:linear-gradient(135deg,var(--bl) 0%,var(--g) 100%);}
.bc-ov{
  position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;
  padding:22px;background:linear-gradient(to top,rgba(14,8,4,.7) 0%,transparent 55%);
}
.bc-cat{font-family:var(--font-body);font-size:9px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:4px;}
.bc-name{font-family:var(--font-head);font-size:clamp(13px,1.6vw,24px);font-weight:700;color:#fff;line-height:1.1;letter-spacing:-.03em;}
.bc-arr{
  position:absolute;top:16px;right:16px;width:34px;height:34px;border-radius:50%;
  background:rgba(255,255,255,.1);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:15px;opacity:0;transform:scale(.4) rotate(-30deg);
  transition:all .3s cubic-bezier(.34,1.56,.64,1);
}
.bc-ltr{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-family:var(--font-head);font-size:140px;font-weight:800;
  color:rgba(255,255,255,.04);user-select:none;pointer-events:none;overflow:hidden;line-height:1;
}

/* ─── SERVICIOS ─── */
.sec-servicios{background:#fff;}
.srv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px;}
.sc{
  background:var(--cream);border-radius:20px;padding:30px 24px 26px;
  position:relative;overflow:hidden;border:1.5px solid transparent;
  transition:all .35s cubic-bezier(.34,1.56,.64,1);
}
.sc:hover{transform:translateY(-7px);border-color:var(--o);box-shadow:0 16px 50px rgba(14,8,4,.08);}
.sc-n{
  position:absolute;top:14px;right:18px;font-family:var(--font-head);font-size:60px;
  font-weight:800;color:rgba(14,8,4,.03);line-height:1;pointer-events:none;
}
.sc-chip{
  display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:100px;
  font-family:var(--font-body);font-size:9px;font-weight:700;letter-spacing:.09em;
  text-transform:uppercase;margin-bottom:16px;
}
.chip-o{background:rgba(240,78,26,.1);color:var(--o);}
.chip-p{background:rgba(155,111,212,.12);color:var(--p);}
.chip-pk{background:rgba(232,71,122,.1);color:var(--pk);}
.chip-l{background:rgba(196,212,0,.18);color:#4d5a00;}
.chip-b{background:rgba(77,184,232,.12);color:#0d7aaa;}
.chip-g{background:rgba(77,189,116,.12);color:#156630;}
.sc-title{font-family:var(--font-head);font-size:var(--h3);font-weight:700;color:var(--dark);margin-bottom:10px;letter-spacing:-.03em;line-height:1.2;}
.sc-desc{font-family:var(--font-body);font-size:12.5px;line-height:1.75;color:rgba(14,8,4,.42);}
.sc-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:16px;}
.sc-tag{
  font-family:var(--font-body);font-size:9px;font-weight:600;padding:4px 11px;
  border-radius:100px;background:rgba(14,8,4,.05);color:rgba(14,8,4,.34);transition:all .2s;
}
.sc:hover .sc-tag{background:rgba(240,78,26,.07);color:var(--o);}
.sc-dark{
  grid-column:span 3;background:var(--dark);border-radius:20px;padding:38px 48px;
  display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center;
  border:1.5px solid transparent;transition:box-shadow .3s;overflow:hidden;position:relative;
}
.sc-dark::before{
  content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(-45deg,transparent,transparent 20px,rgba(255,255,255,.01) 20px,rgba(255,255,255,.01) 40px);
}
.sc-dark:hover{box-shadow:0 24px 70px rgba(14,8,4,.35);}
.sd-txt{position:relative;z-index:1;}
.sd-chip{
  display:inline-flex;align-items:center;gap:5px;background:rgba(240,78,26,.16);color:var(--o);
  padding:4px 13px;border-radius:100px;font-family:var(--font-body);font-size:9px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px;
}
.sd-h{font-family:var(--font-head);font-size:clamp(1.4rem,2.3vw,2.3rem);font-weight:800;color:var(--b);line-height:1.1;letter-spacing:-.04em;}
.sd-h span{color:var(--o);}
.sd-p{font-family:var(--font-body);font-size:12.5px;color:rgba(234,217,184,.4);margin-top:11px;line-height:1.75;}
.sd-cta{
  display:inline-flex;align-items:center;gap:8px;background:var(--o);color:#fff;
  padding:12px 26px;border-radius:100px;font-family:var(--font-body);font-size:12px;font-weight:600;
  margin-top:18px;box-shadow:0 6px 22px rgba(240,78,26,.28);
  transition:transform .3s cubic-bezier(.34,1.56,.64,1);
}
.sd-cta:hover{transform:scale(1.05);}
.sd-stats{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:9px;}
.mstat{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:16px;}
.mstat-n{font-family:var(--font-head);font-size:24px;font-weight:800;color:#fff;letter-spacing:-.04em;}
.mstat-n sup{font-size:.45em;color:var(--o);}
.mstat-l{font-family:var(--font-body);font-size:10px;color:rgba(255,255,255,.26);margin-top:4px;font-weight:400;}
.mstat.accent{background:var(--o);border-color:var(--o);}
.mstat.accent .mstat-l{color:rgba(255,255,255,.62);}

/* ─── QUOTE ─── */
.quote-sec{
  background:var(--o);padding:60px var(--px);
  text-align:center;position:relative;overflow:hidden;
}
.quote-sec::before{
  content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(-45deg,transparent,transparent 18px,rgba(255,255,255,.035) 18px,rgba(255,255,255,.035) 36px);
}
.q-inner{position:relative;z-index:1;max-width:820px;margin:0 auto;}
.q-h{font-family:var(--font-head);font-size:clamp(1.7rem,3.8vw,3.5rem);font-weight:800;color:#fff;line-height:1.06;letter-spacing:-.04em;}
.q-em{color:var(--l);}
.q-it{font-family:var(--font-body);font-style:italic;font-weight:400;font-size:.8em;color:rgba(255,255,255,.65);}
.q-sub{font-family:var(--font-body);font-size:14px;color:rgba(255,255,255,.52);margin-top:16px;line-height:1.7;max-width:500px;margin-left:auto;margin-right:auto;}

/* ─── PROCESOS ─── */
.sec-procesos{background:var(--cream);}
.process-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  border:1.5px solid rgba(14,8,4,.07);border-radius:20px;overflow:hidden;margin-top:44px;
}
.ps{padding:32px 24px;border-right:1.5px solid rgba(14,8,4,.07);position:relative;overflow:hidden;transition:background .3s;}
.ps:last-child{border-right:none;}
.ps:hover{background:#fff;}
.ps-tag{
  display:inline-block;font-family:var(--font-body);font-size:9px;font-weight:700;
  letter-spacing:.07em;padding:5px 13px;border-radius:100px;margin-bottom:18px;
}
.pt1{background:var(--o);color:#fff;}
.pt2{background:var(--p);color:#fff;}
.pt3{background:var(--pk);color:#fff;}
.pt4{background:var(--l);color:var(--dark);}
.ps-h{font-family:var(--font-head);font-size:14px;font-weight:700;color:var(--dark);margin-bottom:9px;letter-spacing:-.02em;line-height:1.2;}
.ps-p{font-family:var(--font-body);font-size:12px;line-height:1.7;color:rgba(14,8,4,.38);}
.ps-deco{
  position:absolute;bottom:10px;right:14px;font-family:var(--font-head);font-size:52px;
  font-weight:800;color:rgba(14,8,4,.035);pointer-events:none;user-select:none;line-height:1;
}

/* ─── MAPA / COBERTURA ─── */
.sec-mapa{background:#fff;}
.mapa-head{margin-bottom:40px;}
.mapa-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,4vw,64px);align-items:start;}
.mapa-wrap{
  background:var(--dark);border-radius:20px;overflow:hidden;
  position:relative;aspect-ratio:16/10;
}
.mapa-wrap svg{width:100%;height:100%;}
/* puntos en el mapa */
.map-dot{cursor:none;}
.map-dot circle{transition:r .2s,opacity .2s;}
.map-dot:hover circle{opacity:1!important;}
.map-pulse{animation:mpulse 2.5s ease-in-out infinite;}
@keyframes mpulse{0%,100%{transform:scale(1);opacity:.7;}50%{transform:scale(1.5);opacity:.2;}}
/* columna derecha */
.cov-intro{font-family:var(--font-body);font-size:14px;line-height:1.85;color:rgba(14,8,4,.42);margin-top:14px;max-width:420px;}
.cov-intro b{color:var(--dark);font-weight:600;}
.cov-cities{margin-top:32px;display:flex;flex-direction:column;gap:10px;}
.cov-city{
  display:flex;align-items:center;gap:14px;padding:16px 20px;
  background:var(--cream);border-radius:14px;border:1.5px solid transparent;
  transition:all .25s;
}
.cov-city:hover{border-color:var(--o);background:#fff;transform:translateX(6px);}
.cov-city-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.cov-city-info{flex:1;}
.cov-city-name{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--dark);letter-spacing:-.02em;}
.cov-city-sub{font-family:var(--font-body);font-size:11px;color:rgba(14,8,4,.36);margin-top:2px;}
.cov-city-tag{
  font-family:var(--font-body);font-size:9px;font-weight:700;
  letter-spacing:.08em;text-transform:uppercase;padding:4px 11px;border-radius:100px;
}
.tag-local{background:rgba(240,78,26,.1);color:var(--o);}
.tag-lat{background:rgba(155,111,212,.12);color:var(--p);}
.tag-us{background:rgba(196,212,0,.18);color:#4d5a00;}
.cov-stats{
  display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:28px;
}
.cov-stat{background:var(--cream);border-radius:14px;padding:18px 20px;}
.cov-stat-n{font-family:var(--font-head);font-size:clamp(20px,2.2vw,28px);font-weight:800;color:var(--dark);letter-spacing:-.04em;}
.cov-stat-n span{color:var(--o);}
.cov-stat-l{font-family:var(--font-body);font-size:11px;color:rgba(14,8,4,.36);margin-top:4px;}

/* ─── TESTIMONIOS ─── */
.sec-testi{background:var(--cream);}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px;}
.tc{border-radius:20px;padding:30px;transition:transform .3s;}
.tc:hover{transform:translateY(-6px);}
.tc1{background:var(--p);}
.tc2{background:#fff;border:1.5px solid rgba(14,8,4,.07);}
.tc3{background:var(--o);}
.tc-stars{font-size:12px;letter-spacing:2px;margin-bottom:16px;}
.tc1 .tc-stars,.tc3 .tc-stars{color:var(--l);}
.tc2 .tc-stars{color:var(--o);}
.tc-q{font-family:var(--font-body);font-size:13px;font-style:italic;font-weight:400;line-height:1.7;margin-bottom:20px;}
.tc1 .tc-q,.tc3 .tc-q{color:rgba(255,255,255,.85);}
.tc2 .tc-q{color:var(--dark);}
.tc-auth{display:flex;align-items:center;gap:11px;}
.tcav{
  width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-family:var(--font-head);font-size:11px;font-weight:700;flex-shrink:0;
}
.av1{background:var(--l);color:var(--dark);}
.av2{background:var(--o);color:#fff;}
.av3{background:var(--b);color:var(--dark);}
.tc-nm{font-family:var(--font-body);font-size:12px;font-weight:600;}
.tc-rl{font-family:var(--font-body);font-size:10px;opacity:.4;margin-top:2px;font-weight:400;}
.tc1 .tc-nm,.tc1 .tc-rl,.tc3 .tc-nm,.tc3 .tc-rl{color:#fff;}
.tc2 .tc-nm{color:var(--dark);}

/* ─── FOOTER CTA ─── */
.footer-cta{
  background:var(--dark);padding:80px var(--px) 0;
  position:relative;overflow:hidden;text-align:center;
}
.fc-deco{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  opacity:.03;animation:blobspin 50s linear infinite;pointer-events:none;
}
.fc-inner{position:relative;z-index:1;max-width:680px;margin:0 auto 70px;}
.fc-eye{color:var(--o);justify-content:center;margin-bottom:20px;}
.fc-h{
  font-family:var(--font-head);font-size:clamp(2.4rem,5.5vw,5.5rem);
  font-weight:800;line-height:1.0;letter-spacing:-.06em;color:var(--b);
}
.fc-h .fl{color:var(--l);}
.fc-h .fo{color:var(--o);}
.fc-sub{font-family:var(--font-body);font-size:14px;color:rgba(234,217,184,.3);margin:18px 0 32px;line-height:1.7;}
.fc-btns{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;}
.btn-fc{
  background:var(--o);color:#fff;padding:14px 36px;border-radius:100px;
  font-family:var(--font-body);font-size:13px;font-weight:600;
  display:inline-flex;align-items:center;gap:8px;
  box-shadow:0 8px 30px rgba(240,78,26,.34);
  transition:transform .35s cubic-bezier(.34,1.56,.64,1);
}
.btn-fc:hover{transform:scale(1.06);}
.btn-fc-g{
  color:rgba(234,217,184,.34);font-family:var(--font-body);font-size:13px;font-weight:500;
  border:1.5px solid rgba(234,217,184,.08);padding:14px 26px;border-radius:100px;
  display:inline-flex;align-items:center;gap:7px;transition:all .25s;
}
.btn-fc-g:hover{color:var(--b);border-color:rgba(234,217,184,.24);}
.footer-grid{
  border-top:1px solid rgba(234,217,184,.06);padding:44px var(--px);
  display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px;
  align-items:start;background:var(--dark);
}
.fg-logo{
  font-family:var(--font-head);font-size:19px;font-weight:800;color:var(--b);
  display:flex;align-items:center;gap:9px;margin-bottom:10px;letter-spacing:-.03em;
}
.fg-dot{width:7px;height:7px;border-radius:50%;background:var(--o);animation:dotpulse 2s ease-in-out infinite;}
.fg-tag{font-family:var(--font-body);font-size:11px;color:rgba(234,217,184,.24);line-height:1.7;max-width:200px;}
.fcol h4{
  font-family:var(--font-body);font-size:9px;font-weight:700;letter-spacing:.18em;
  text-transform:uppercase;color:rgba(234,217,184,.17);margin-bottom:15px;
}
.fcol ul{list-style:none;display:flex;flex-direction:column;gap:8px;}
.fcol ul a{font-family:var(--font-body);font-size:12px;color:rgba(234,217,184,.28);transition:color .2s;font-weight:400;}
.fcol ul a:hover{color:var(--o);}
.footer-base{
  padding:16px var(--px) 24px;display:flex;align-items:center;
  justify-content:space-between;background:var(--dark);
}
.fb-copy{font-family:var(--font-body);font-size:10px;color:rgba(234,217,184,.12);}
.fb-soc{display:flex;gap:6px;}
.fbs{
  width:32px;height:32px;border-radius:50%;border:1px solid rgba(234,217,184,.07);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-body);font-size:10px;font-weight:600;color:rgba(234,217,184,.26);
  transition:all .25s;
}
.fbs:hover{background:var(--o);border-color:var(--o);color:#fff;transform:scale(1.1);}

/* ─── REVEAL ─── */
.rv{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease;}
.rv.show{opacity:1;transform:none;}
.rv.d1{transition-delay:.1s}.rv.d2{transition-delay:.2s}.rv.d3{transition-delay:.3s}.rv.d4{transition-delay:.4s}

/* ═══ RESPONSIVE ═══ */
@media(max-width:1023px){
  nav{padding:12px 24px;}
  .n-links{display:none;}
  .n-avail{display:none;}
  .n-ham{display:flex;}
  .hero{grid-template-columns:1fr;min-height:auto;padding:100px 24px 56px;gap:40px;}
  .sec-conocenos{grid-template-columns:1fr;gap:40px;}
  .sec-conocenos::after{display:none;}
  .bento{grid-template-columns:1fr 1fr;grid-auto-rows:auto;}
  .bc1,.bc2,.bc3,.bc4,.bc5,.bc6{grid-column:auto;grid-row:auto;aspect-ratio:4/3;}
  .srv-grid{grid-template-columns:1fr 1fr;}
  .sc-dark{grid-column:span 2;grid-template-columns:1fr;}
  .process-grid{grid-template-columns:1fr 1fr;}
  .ps{border-bottom:1.5px solid rgba(14,8,4,.07);}
  .ps:nth-child(odd){border-right:1.5px solid rgba(14,8,4,.07);}
  .ps:nth-child(even){border-right:none;}
  .testi-grid{grid-template-columns:1fr 1fr;}
  .tc:last-child{grid-column:span 2;}
  .footer-grid{grid-template-columns:1fr 1fr;gap:28px;padding:36px 24px;}
  .footer-base{padding:14px 24px 22px;}
  .mapa-grid{grid-template-columns:1fr;}
  .stats-row{grid-template-columns:1fr 1fr;}
  .stat{border-bottom:1px solid rgba(14,8,4,.06);}
  .tj-head{flex-wrap:wrap;gap:16px;}
}
@media(max-width:767px){
  .hero{padding:90px 20px 48px;gap:30px;}
  .form-grid{grid-template-columns:1fr;}
  .srv-grid,.testi-grid{grid-template-columns:1fr;}
  .sc-dark{grid-column:span 1;padding:26px 22px;}
  .tc:last-child{grid-column:auto;}
  .process-grid{grid-template-columns:1fr;}
  .ps{border-right:none!important;border-bottom:1.5px solid rgba(14,8,4,.07);}
  .ps:last-child{border-bottom:none;}
  .bento{grid-template-columns:1fr;}
  .bc1,.bc2,.bc3,.bc4,.bc5,.bc6{aspect-ratio:5/3;}
  .stats-row{grid-template-columns:1fr 1fr;}
  .stat{padding:24px 22px;}
  .footer-grid{grid-template-columns:1fr;gap:22px;padding:30px 20px;}
  .footer-base{flex-direction:column;gap:12px;text-align:center;padding:14px 20px 20px;}
  .fc-btns,.h-btns{flex-direction:column;align-items:stretch;}
  .btn-primary,.btn-ghost-sm,.btn-fc,.btn-fc-g{width:100%;justify-content:center;}
  .tj-head{flex-direction:column;align-items:flex-start;gap:14px;}
  .cov-stats{grid-template-columns:1fr 1fr;}
  .cl-logos{gap:22px;}
}
@media(max-width:380px){
  .stats-row{grid-template-columns:1fr;}
  .stat:last-child{border-bottom:none;}
}
</style>
</head>
<body>
<div id="cursor"></div>
<div id="cur-ring"></div>

<!-- COLOR STRIP FIJO -->
<div class="cstrip"><div class="cs1"></div><div class="cs2"></div><div class="cs3"></div><div class="cs4"></div><div class="cs5"></div><div class="cs6"></div><div class="cs7"></div><div class="cs8"></div></div>

<svg style="display:none" xmlns="http://www.w3.org/2000/svg">
  <symbol id="tivo" viewBox="0 0 100 100">
