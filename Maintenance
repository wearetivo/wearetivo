<script>
// CURSOR
const cur=document.getElementById('cursor'),ring=document.getElementById('cur-ring');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
(function rl(){rx+=(mx-rx)*.11;ry+=(my-ry)*.11;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(rl);})();
document.querySelectorAll('a,button,input,select').forEach(el=>{
  el.addEventListener('mouseenter',()=>cur.classList.add('hover'));
  el.addEventListener('mouseleave',()=>cur.classList.remove('hover'));
});

// NAV SCROLL — laterales se desvanecen, centro queda
const navAvail=document.querySelector('.n-avail');
const navTalk=document.querySelector('.n-talk');
window.addEventListener('scroll',()=>{
  const hide=scrollY>50;
  [navAvail,navTalk].forEach(el=>{
    if(!el)return;
    el.style.transform=hide?'translateY(-80px)':'translateY(0)';
    el.style.opacity=hide?'0':'1';
    el.style.pointerEvents=hide?'none':'auto';
  });
},{passive:true});

// MOBILE MENU
const mob=document.getElementById('mobMenu');
document.getElementById('hamBtn').addEventListener('click',()=>mob.style.display=mob.style.display==='flex'?'none':'flex');
document.getElementById('mobX').addEventListener('click',()=>mob.style.display='none');
function closeMob(){mob.style.display='none';}

// TYPING
const phrases=['la intención humana.','la estrategia creativa.','el diseño con alma.','la conexión real.','las decisiones correctas.','la visión de marca.'];
let pi=0,ci=0,del=false,paused=false;
const tel=document.getElementById('typing');
function type(){
  if(paused){setTimeout(type,1800);paused=false;return;}
  const ph=phrases[pi];
  if(!del){tel.textContent=ph.slice(0,++ci);if(ci===ph.length){del=true;paused=true;setTimeout(type,100);return;}setTimeout(type,60);}
  else{tel.textContent=ph.slice(0,--ci);if(ci===0){del=false;pi=(pi+1)%phrases.length;setTimeout(type,380);return;}setTimeout(type,35);}
}
type();

// REVEAL
const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('show');}),{threshold:.07,rootMargin:'0px 0px -24px 0px'});
document.querySelectorAll('.rv').forEach(el=>obs.observe(el));

// STAT COUNTERS
const targets=[80,3,100,6];
const els=['s1','s2','s3','s4'];
const suffixes=['<sup>+</sup>','<sup>M+</sup>','<sup>%</sup>','<sup>+</sup>'];
let animated=false;
const sObs=new IntersectionObserver(e=>{
  if(e[0].isIntersecting&&!animated){
    animated=true;
    els.forEach((id,i)=>{
      const el=document.getElementById(id);
      let v=0;
      const run=()=>{v+=targets[i]/55;if(v>=targets[i]){el.innerHTML=targets[i]+suffixes[i];return;}el.innerHTML=Math.round(v)+suffixes[i];requestAnimationFrame(run);};
      run();
    });
  }
},{threshold:.3});
const sr=document.querySelector('.stats-row');
if(sr)sObs.observe(sr);

// BENTO TILT
document.querySelectorAll('.bc').forEach(c=>{
  c.addEventListener('mousemove',e=>{
    const r=c.getBoundingClientRect();
    const x=((e.clientX-r.left)/r.width-.5)*12;
    const y=((e.clientY-r.top)/r.height-.5)*12;
    c.style.transform=`perspective(900px) rotateY(${x}deg) rotateX(${-y}deg) scale(1.03)`;
  });
  c.addEventListener('mouseleave',()=>c.style.transform='');
});
</script>
